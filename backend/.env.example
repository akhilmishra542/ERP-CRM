# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL connection string)
# Local example: postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public
# Neon / Supabase / Render Postgres: copy the connection string they give you
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public"

# JWT
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
